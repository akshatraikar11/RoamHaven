<% layout("/layouts/boilerplate") %>

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
    <h2 class="mb-0">Revenue Dashboard</h2>
    <div class="text-muted small">Host earnings from confirmed payments.</div>
  </div>

  <div class="row mt-3 g-3">
    <div class="col-md-6">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <div class="text-muted small">Total (last 6 months)</div>
          <div class="h3 mb-0">₹<%= Math.round((totalsRupees || 0)).toLocaleString("en-IN") %></div>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <div class="text-muted small">Commission model</div>
          <div class="fw-semibold">10% platform fee · 90% host payout</div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm mt-3">
    <div class="card-body">
      <h3 class="h5 mb-3">Monthly earnings</h3>
      <% if (!monthLabels || monthLabels.length === 0) { %>
        <div class="text-muted">No paid bookings yet.</div>
      <% } else { %>
        <canvas id="earningsChart" height="110"></canvas>
      <% } %>
    </div>
  </div>

  <div class="card shadow-sm mt-3">
    <div class="card-body">
      <h3 class="h5 mb-3">Payout history</h3>
      <% if (!payoutHistory || payoutHistory.length === 0) { %>
        <div class="text-muted">No payouts yet.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-striped align-middle">
            <thead>
              <tr>
                <th>Date</th>
                <th>Listing</th>
                <th>Host payout</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% payoutHistory.forEach((p) => { %>
                <tr>
                  <td><%= p.createdAt ? new Date(p.createdAt).toLocaleDateString("en-IN") : "-" %></td>
                  <td class="fw-semibold"><%= p.listing ? p.listing.title : "Listing" %></td>
                  <td>₹<%= Math.round((p.hostPayout || 0) / 100).toLocaleString("en-IN") %></td>
                  <td>
                    <span class="badge bg-success"><%= p.status %></span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<% if (monthLabels && monthLabels.length > 0) { %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    const ctx = document.getElementById("earningsChart");
    const labels = <%- JSON.stringify(monthLabels) %>;
    const data = <%- JSON.stringify(monthlyEarningsRupees || []) %>;

    new Chart(ctx, {
      type: "bar",
      data: {
        labels,
        datasets: [{
          label: "Earnings (₹)",
          data,
          backgroundColor: "rgba(230, 30, 77, 0.2)",
          borderColor: "rgba(230, 30, 77, 1)",
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: { beginAtZero: true }
        }
      }
    });
  </script>
<% } %>

