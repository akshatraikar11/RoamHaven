      <!-- Feature #9: Carousel & Lightbox Script -->
      <script>
        (function() {
          // Feature #136: comparison basket
          const selected = new Set();
          document.querySelectorAll('.compare-add-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
              if (selected.has(btn.dataset.id)) {
                selected.delete(btn.dataset.id);
                btn.classList.remove('btn-success');
              } else {
                if (selected.size >= 3) return;
                selected.add(btn.dataset.id);
                btn.classList.add('btn-success');
              }
            });
          });
          const goBtn = document.getElementById('goCompareBtn');
          if (goBtn) {
            goBtn.addEventListener('click', () => {
              if (selected.size < 2) {
                alert('Choose at least 2 listings.');
                return;
              }
              window.location.href = `/listings/compare?ids=${[...selected].join(',')}`;
            });
          }
        })();

        // Carousel
        let currentSlide = 0;
        const slides = document.querySelectorAll('.carousel-slide');
        const dots = document.querySelectorAll('.carousel-dot');

        function changeSlide(dir) {
          if (slides.length === 0) return;
          slides[currentSlide].classList.remove('active');
          if (dots[currentSlide]) dots[currentSlide].classList.remove('active');
          currentSlide = (currentSlide + dir + slides.length) % slides.length;
          slides[currentSlide].classList.add('active');
          if (dots[currentSlide]) dots[currentSlide].classList.add('active');
        }

        function goToSlide(index) {
          if (slides.length === 0) return;
          slides[currentSlide].classList.remove('active');
          if (dots[currentSlide]) dots[currentSlide].classList.remove('active');
          currentSlide = index;
          slides[currentSlide].classList.add('active');
          if (dots[currentSlide]) dots[currentSlide].classList.add('active');
        }

        // Lightbox
        const allImageUrls = <%- JSON.stringify((listing.images && listing.images.length > 0 ? listing.images : [listing.image]).map(img => img.url)) %>;
        let lightboxIndex = 0;

        function openLightbox(index) {
          lightboxIndex = index;
          const overlay = document.getElementById('lightboxOverlay');
          const img = document.getElementById('lightboxImage');
          const counter = document.getElementById('lightboxCounter');
          img.src = allImageUrls[lightboxIndex];
          counter.textContent = `${lightboxIndex + 1} / ${allImageUrls.length}`;
          overlay.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }

        function closeLightbox(e) {
          if (e) e.stopPropagation();
          document.getElementById('lightboxOverlay').style.display = 'none';
          document.body.style.overflow = 'auto';
        }

        function lightboxNav(dir, e) {
          if (e) e.stopPropagation();
          lightboxIndex = (lightboxIndex + dir + allImageUrls.length) % allImageUrls.length;
          document.getElementById('lightboxImage').src = allImageUrls[lightboxIndex];
          document.getElementById('lightboxCounter').textContent = `${lightboxIndex + 1} / ${allImageUrls.length}`;
        }

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
          const overlay = document.getElementById('lightboxOverlay');
          if (overlay.style.display !== 'none') {
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') lightboxNav(-1);
            if (e.key === 'ArrowRight') lightboxNav(1);
          }
        });
      </script>

      <!-- Feature #16: Availability Calendar Script -->
      <script>
        (function() {
          const listingId = '<%= listing._id %>';
          const isOwner = <%= currUser && listing.owner && String(listing.owner._id) === String(currUser._id) ? 'true' : 'false' %>;
          const basePrice = <%= listing.price %>;
          const weekendPrice = <%= listing.weekendPrice || listing.price %>;
          let blockedDates = [];
          let calDate = new Date();

          async function fetchBlockedDates() {
            try {
              const res = await fetch(`/listings/${listingId}/availability`);
              const data = await res.json();
              blockedDates = data.blockedDates || [];
              renderCalendar();
            } catch(e) {
              console.error('Failed to fetch availability:', e);
              renderCalendar();
            }
          }

          function renderCalendar() {
            const year = calDate.getFullYear();
            const month = calDate.getMonth();
            const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
            document.getElementById('calMonthLabel').textContent = `${monthNames[month]} ${year}`;

            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const today = new Date();
            today.setHours(0,0,0,0);

            const container = document.getElementById('calDays');
            container.innerHTML = '';

            // Empty cells for offset
            for (let i = 0; i < firstDay; i++) {
              const empty = document.createElement('div');
              empty.className = 'cal-day empty';
              container.appendChild(empty);
            }

            for (let d = 1; d <= daysInMonth; d++) {
              const dateObj = new Date(year, month, d);
              const dateStr = dateObj.toISOString().split('T')[0];
              const isPast = dateObj < today;
              const isBlocked = blockedDates.includes(dateStr);
              const dayOfWeek = dateObj.getDay();
              const isWeekend = (dayOfWeek === 5 || dayOfWeek === 6);

              const cell = document.createElement('div');
              cell.className = 'cal-day';
              if (isPast) cell.classList.add('past');
              if (isBlocked) cell.classList.add('blocked');
              if (isWeekend && !isBlocked && !isPast) cell.classList.add('weekend');

              cell.innerHTML = `<span class="cal-day-num">${d}</span>`;
              if (!isPast && isWeekend && weekendPrice !== basePrice) {
                cell.innerHTML += `<span class="cal-price">₹${weekendPrice.toLocaleString('en-IN')}</span>`;
              } else if (!isPast && !isBlocked) {
                cell.innerHTML += `<span class="cal-price">₹${basePrice.toLocaleString('en-IN')}</span>`;
              }

              // Host can toggle blocked dates
              if (isOwner && !isPast) {
                cell.style.cursor = 'pointer';
                cell.addEventListener('click', async () => {
                  const action = isBlocked ? 'unblock' : 'block';
                  try {
                    await fetch(`/listings/${listingId}/availability?_method=PUT`, {
                      method: 'PUT',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ date: dateStr, action })
                    });
                    await fetchBlockedDates();
                  } catch(e) {
                    console.error('Failed to update availability:', e);
                  }
                });
              }

              container.appendChild(cell);
            }
          }

          document.getElementById('calPrev').addEventListener('click', () => {
            calDate.setMonth(calDate.getMonth() - 1);
            renderCalendar();
          });
          document.getElementById('calNext').addEventListener('click', () => {
            calDate.setMonth(calDate.getMonth() + 1);
            renderCalendar();
          });

          fetchBlockedDates();
        })();
      </script>

      <!-- Feature #17: Dynamic Price Update Script -->
      <script>
        (function() {
          const listingId = '<%= listing._id %>';
          const checkInEl = document.getElementById('checkInDate');
          const checkOutEl = document.getElementById('checkOutDate');

          async function updatePrice() {
            const checkIn = checkInEl.value;
            const checkOut = checkOutEl.value;
            if (!checkIn || !checkOut) return;

            try {
              const res = await fetch(`/listings/${listingId}/dynamic-price?checkIn=${checkIn}&checkOut=${checkOut}`);
              const data = await res.json();

              document.getElementById('nightCount').textContent = data.nights;
              document.getElementById('nightPlural').textContent = data.nights !== 1 ? 's' : '';
              document.getElementById('displayPrice').textContent = `₹${data.nightlyPrice.toLocaleString('en-IN')}`;
              document.getElementById('totalPriceDisplay').textContent = `₹${data.totalPrice.toLocaleString('en-IN')}`;

              const serviceFee = Math.round(data.totalPrice * 0.05);
              document.getElementById('serviceFeeDisplay').textContent = `₹${serviceFee.toLocaleString('en-IN')}`;

              const grandTotal = data.totalPrice + serviceFee;
              document.getElementById('grandTotalDisplay').innerHTML = `<strong>₹${grandTotal.toLocaleString('en-IN')}</strong>`;
            } catch(e) {
              console.error('Failed to fetch dynamic price:', e);
            }
          }

          if (checkInEl) checkInEl.addEventListener('change', updatePrice);
          if (checkOutEl) checkOutEl.addEventListener('change', updatePrice);
        })();
      </script>

