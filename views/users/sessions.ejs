<% layout("/layouts/boilerplate") %>

<div class="account-page">
  <div class="container py-4">
    <!-- Account Navigation -->
    <div class="account-nav mb-4">
      <a href="/account/sessions" class="account-nav-link active">
        <i class="fa-solid fa-shield-halved"></i> Sessions
      </a>
      <a href="/account/activity" class="account-nav-link">
        <i class="fa-solid fa-clock-rotate-left"></i> Activity Log
      </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="fw-bold mb-1">Active Sessions</h2>
        <p class="text-muted mb-0">
          Manage your active sessions across devices. If you see a session you don't recognize, revoke it immediately.
        </p>
      </div>
      <% if (sessions.length > 1) { %>
        <form action="/account/sessions/revoke-all" method="POST" class="d-inline">
          <button type="submit" class="btn btn-outline-danger"
            onclick="return confirm('Are you sure you want to revoke all other sessions? You will stay logged in on this device only.')">
            <i class="fa-solid fa-right-from-bracket me-1"></i> Revoke All Others
          </button>
        </form>
      <% } %>
    </div>

    <% if (sessions.length === 0) { %>
      <div class="text-center py-5">
        <i class="fa-solid fa-shield-check text-muted" style="font-size: 3rem;"></i>
        <p class="text-muted mt-3">No active sessions found.</p>
      </div>
    <% } else { %>
      <div class="session-list">
        <% sessions.forEach(function(session) { %>
          <div class="session-card <%= session.isCurrent ? 'session-current' : '' %>">
            <div class="session-icon">
              <% if (session.device === 'Desktop') { %>
                <i class="fa-solid fa-desktop"></i>
              <% } else if (['mobile', 'Mobile', 'smartphone'].includes(session.device)) { %>
                <i class="fa-solid fa-mobile-screen-button"></i>
              <% } else if (['tablet', 'Tablet'].includes(session.device)) { %>
                <i class="fa-solid fa-tablet-screen-button"></i>
              <% } else { %>
                <i class="fa-solid fa-globe"></i>
              <% } %>
            </div>

            <div class="session-info">
              <div class="session-device">
                <%= session.browser || 'Unknown Browser' %>
                <% if (session.isCurrent) { %>
                  <span class="session-badge-current">This device</span>
                <% } %>
              </div>
              <div class="session-details">
                <span><i class="fa-solid fa-microchip me-1"></i><%= session.os || 'Unknown OS' %></span>
                <span class="session-dot">·</span>
                <span><i class="fa-solid fa-wifi me-1"></i><%= session.ip || 'Unknown IP' %></span>
                <span class="session-dot">·</span>
                <span><i class="fa-regular fa-clock me-1"></i>
                  <%
                    const lastActive = new Date(session.lastActive);
                    const diffMs = Date.now() - lastActive.getTime();
                    const diffMins = Math.floor(diffMs / 60000);
                    let timeAgo = 'Just now';
                    if (diffMins >= 1440) timeAgo = Math.floor(diffMins/1440) + 'd ago';
                    else if (diffMins >= 60) timeAgo = Math.floor(diffMins/60) + 'h ago';
                    else if (diffMins >= 1) timeAgo = diffMins + 'm ago';
                  %>
                  <%= timeAgo %>
                </span>
              </div>
            </div>

            <div class="session-actions">
              <% if (session.isCurrent) { %>
                <span class="text-success fw-semibold small">
                  <i class="fa-solid fa-circle" style="font-size: 8px;"></i> Active
                </span>
              <% } else { %>
                <form action="/account/sessions/<%= session._id %>/revoke" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-sm btn-outline-danger session-revoke-btn"
                    onclick="return confirm('Revoke this session?')">
                    Revoke
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <div class="mt-4 p-3 bg-light rounded-3">
      <p class="mb-0 text-muted small">
        <i class="fa-solid fa-circle-info me-1 text-primary"></i>
        Sessions are automatically cleaned up after 7 days of inactivity.
        If you suspect unauthorized access, revoke all sessions and change your password immediately.
      </p>
    </div>
  </div>
</div>
