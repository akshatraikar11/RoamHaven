<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-8 offset-2 col-md-6 offset-md-3">
    <div class="card shadow-sm border-0 auth-card">
      <div class="card-body p-4 p-md-5">
        <h2 class="text-center mb-2 fw-bold text-dark">Forgot Password?</h2>
        <p class="text-center text-muted mb-4">
          No worries! Enter your email and we'll send you a reset link.
        </p>

        <form action="/forgot-password" method="POST" class="needs-validation" novalidate>
          <div class="mb-4">
            <label for="email" class="form-label fw-semibold text-secondary">Email Address</label>
            <input name="email" id="email" type="email"
              class="form-control form-control-lg bg-light border-0"
              placeholder="your-email@example.com"
              required />
            <div class="invalid-feedback">Please enter a valid email address.</div>
          </div>

          <button class="btn btn-primary w-100 btn-lg mb-3">
            <i class="fa-solid fa-paper-plane me-2"></i>Send Reset Link
          </button>
        </form>

        <div class="text-center mt-3">
          <a href="/login" class="text-decoration-none text-muted">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Login
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
