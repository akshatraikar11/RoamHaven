<% layout("/layouts/boilerplate") %>

<div class="container py-4">
  <h2 class="fw-bold mb-2">Guest ID Verification</h2>
  <p class="text-muted">Upload a government-issued ID to receive a verified guest badge.</p>

  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <p class="mb-2">
        Current status:
        <span class="badge bg-<%= verification?.status === 'verified' ? 'success' : verification?.status === 'pending' ? 'warning text-dark' : 'secondary' %>">
          <%= verification?.status || "unverified" %>
        </span>
      </p>

      <% if (verification?.idImage?.url) { %>
        <img src="<%= verification.idImage.url %>" alt="Uploaded ID" class="img-fluid rounded mb-3" style="max-height: 260px;" />
      <% } %>

      <form action="/account/verify-id" method="POST" enctype="multipart/form-data">
        <div class="mb-3">
          <label class="form-label">Upload ID image</label>
          <input type="file" class="form-control" name="idImage" accept="image/*" required />
        </div>
        <button class="btn btn-dark">Submit for Verification</button>
      </form>
    </div>
  </div>
</div>
