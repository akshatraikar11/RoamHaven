<% layout("/layouts/boilerplate") %>

<div class="container py-4">
  <div class="row g-4">
    <div class="col-lg-4">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3">
            <% if (profileUser.avatar && profileUser.avatar.url) { %>
              <img src="<%= profileUser.avatar.url %>" alt="avatar" style="width:72px;height:72px;border-radius:18px;object-fit:cover;" />
            <% } else { %>
              <div style="width:72px;height:72px;border-radius:18px;background:#111;color:#fff;display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;">
                <%= (profileUser.username || "U").charAt(0).toUpperCase() %>
              </div>
            <% } %>
            <div>
              <div class="h5 mb-1"><%= profileUser.username %></div>
              <div class="text-muted small">
                Member since <%= profileUser._id ? profileUser._id.getTimestamp().toLocaleDateString("en-IN", { month: "short", year: "numeric" }) : "" %>
              </div>
            </div>
          </div>

          <hr />

          <div class="fw-semibold mb-2">Verification badges</div>
          <div class="d-flex flex-wrap gap-2">
            <span class="badge text-bg-<%= profileUser.isEmailVerified ? 'success' : 'secondary' %>">Email <%= profileUser.isEmailVerified ? '✓' : '—' %></span>
            <span class="badge text-bg-<%= profileUser.isPhoneVerified ? 'success' : 'secondary' %>">Phone <%= profileUser.isPhoneVerified ? '✓' : '—' %></span>
            <span class="badge text-bg-<%= profileUser.googleId ? 'success' : 'secondary' %>">Google <%= profileUser.googleId ? '✓' : '—' %></span>
            <span class="badge text-bg-<%= profileUser.idVerification?.status === 'verified' ? 'success' : 'secondary' %>">ID <%= profileUser.idVerification?.status || 'unverified' %></span>
          </div>

          <hr />

          <div class="fw-semibold">About</div>
          <div class="text-muted small mt-1" style="white-space: pre-wrap;"><%= profileUser.bio || "No bio yet." %></div>

          <div class="mt-3">
            <div class="fw-semibold">Languages</div>
            <div class="text-muted small mt-1">
              <%= (profileUser.languages && profileUser.languages.length > 0) ? profileUser.languages.join(", ") : "—" %>
            </div>
          </div>

          <div class="mt-3">
            <div class="fw-semibold">Loyalty points</div>
            <div class="text-muted small mt-1"><%= profileUser.loyaltyPoints || 0 %> pts</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <% if (isSelf) { %>
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body">
            <h5 class="mb-3">Edit profile</h5>
            <form action="/profile" method="POST" enctype="multipart/form-data">
              <div class="mb-3">
                <label class="form-label">Bio</label>
                <textarea class="form-control" name="bio" rows="4" maxlength="500" placeholder="Tell guests a bit about you..."><%= profileUser.bio || "" %></textarea>
              </div>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Languages (comma-separated)</label>
                  <input class="form-control" name="languages" value="<%= (profileUser.languages || []).join(', ') %>" placeholder="English, Hindi" />
                </div>
                <div class="col-md-6">
                  <label class="form-label">Phone</label>
                  <input class="form-control" name="phone" value="<%= profileUser.phone || '' %>" placeholder="+91..." />
                </div>
              </div>
              <div class="mt-3">
                <label class="form-label">Avatar</label>
                <input class="form-control" type="file" name="avatar" accept="image/*" />
              </div>
              <button class="btn btn-dark mt-3" type="submit">Save changes</button>
            </form>
          </div>
        </div>
      <% } %>

      <div class="card shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h5 class="mb-0">Wishlist</h5>
            <a href="/wishlist" class="btn btn-sm btn-outline-dark">Open wishlist</a>
          </div>
          <p class="text-muted small mt-2 mb-0">Save listings you love for later.</p>
        </div>
      </div>
    </div>
  </div>
</div>

