<% layout("/layouts/boilerplate") %>

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
    <div>
      <h2 class="mb-1">Admin Dashboard</h2>
      <div class="text-muted small">Platform overview with live analytics</div>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/coupons" class="btn btn-outline-dark">Manage Coupons</a>
      <a href="/listings" class="btn btn-dark">Back to site</a>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-md-3 col-6">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="text-muted small">Total users</div>
          <div class="h3 mb-0" id="statTotalUsers"><%= totalUsers %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="text-muted small">Total listings</div>
          <div class="h3 mb-0" id="statTotalListings"><%= totalListings %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="text-muted small">Total bookings</div>
          <div class="h3 mb-0" id="statTotalBookings"><%= totalBookings %></div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <div class="text-muted small">Total revenue</div>
          <div class="h3 mb-0">₹<%= (totalRevenueRupees || 0).toLocaleString("en-IN") %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0 mt-3">
    <div class="card-body">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h3 class="h5 mb-0">Live analytics</h3>
        <span class="badge text-bg-success" id="livePulse">● Live</span>
      </div>
      <div class="row g-3">
        <div class="col-md-3 col-6">
          <div class="p-3 rounded bg-light">
            <div class="text-muted small">Active users</div>
            <div class="h4 mb-0" id="liveActiveUsers"><%= liveStats.activeUsers %></div>
          </div>
        </div>
        <div class="col-md-3 col-6">
          <div class="p-3 rounded bg-light">
            <div class="text-muted small">Bookings today</div>
            <div class="h4 mb-0" id="liveBookingsToday"><%= liveStats.bookingsToday %></div>
          </div>
        </div>
        <div class="col-md-3 col-6">
          <div class="p-3 rounded bg-light">
            <div class="text-muted small">Revenue today</div>
            <div class="h4 mb-0" id="liveRevenueToday">₹<%= (liveStats.revenueTodayRupees || 0).toLocaleString("en-IN") %></div>
          </div>
        </div>
        <div class="col-md-3 col-6">
          <div class="p-3 rounded bg-light">
            <div class="text-muted small">Last updated</div>
            <div class="small mb-0" id="liveUpdatedAt"><%= new Date(liveStats.updatedAt).toLocaleTimeString("en-IN") %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row mt-3 g-3">
    <div class="col-lg-6">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <h3 class="h5 mb-3">Monthly revenue</h3>
          <canvas id="adminRevenueChart" height="120"></canvas>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
          <h3 class="h5 mb-3">Monthly bookings</h3>
          <canvas id="adminBookingsChart" height="120"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  const monthLabels = <%- JSON.stringify(monthLabels || []) %>;
  const monthlyRevenueRupees = <%- JSON.stringify(monthlyRevenueRupees || []) %>;
  const monthlyBookingCounts = <%- JSON.stringify(monthlyBookingCounts || []) %>;

  if (monthLabels.length > 0) {
    new Chart(document.getElementById("adminRevenueChart"), {
      type: "line",
      data: {
        labels: monthLabels,
        datasets: [{
          label: "Revenue (₹)",
          data: monthlyRevenueRupees,
          borderColor: "rgba(230, 30, 77, 1)",
          backgroundColor: "rgba(230, 30, 77, 0.15)",
          tension: 0.3,
          fill: true,
        }],
      },
      options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } },
    });

    new Chart(document.getElementById("adminBookingsChart"), {
      type: "bar",
      data: {
        labels: monthLabels,
        datasets: [{
          label: "Bookings",
          data: monthlyBookingCounts,
          backgroundColor: "rgba(52, 152, 219, 0.35)",
          borderColor: "rgba(52, 152, 219, 1)",
          borderWidth: 1,
        }],
      },
      options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } },
    });
  }

  if (window.io) {
    const socket = window.io();
    socket.emit("admin:analytics:subscribe");
    socket.on("admin:analytics:update", (stats) => {
      if (!stats) return;
      document.getElementById("liveActiveUsers").textContent = stats.activeUsers ?? 0;
      document.getElementById("liveBookingsToday").textContent = stats.bookingsToday ?? 0;
      document.getElementById("liveRevenueToday").textContent =
        "₹" + Number(stats.revenueTodayRupees || 0).toLocaleString("en-IN");
      if (stats.updatedAt) {
        document.getElementById("liveUpdatedAt").textContent =
          new Date(stats.updatedAt).toLocaleTimeString("en-IN");
      }
    });
  }
</script>
