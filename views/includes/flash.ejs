<div id="flash-data" class="d-none">
  <% const safeSuccess = typeof success !== "undefined" ? success : []; %>
  <% const safeError = typeof error !== "undefined" ? error : []; %>
  <% if (safeSuccess && safeSuccess.length) { %>
    <span data-flash-type="success" data-flash-message="<%= safeSuccess[0] %>"></span>
  <% } %>
  <% if (safeError && safeError.length) { %>
    <span data-flash-type="error" data-flash-message="<%= safeError[0] %>"></span>
  <% } %>
</div>
