<style>
  .search-btn {
    background-color: #ff385c;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
    border: none;
    font-weight: 500;
  }

  .search-btn:hover {
    background-color: #ff385c;
    color: #fff;
    opacity: 0.9;
  }

  .search-btn i {
    display: inline;
    margin: 0.5rem;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
    font-size: 1rem;
  }
</style>
<%
  const safeCurrUser = typeof currUser !== "undefined" ? currUser : null;
  const safeUserRole = typeof userRole !== "undefined" ? userRole : null;
  const safeWalletBalance = typeof walletBalance !== "undefined" ? walletBalance : 0;
  const safeLoyaltyPoints = typeof loyaltyPoints !== "undefined" ? loyaltyPoints : 0;
  const safeIdVerificationStatus =
    typeof idVerificationStatus !== "undefined" ? idVerificationStatus : "unverified";
  const safeIsEmailVerified =
    typeof isEmailVerified !== "undefined" ? isEmailVerified : false;
%>
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings">
      <div class="brand-container">
        <img src="/images/logo.svg?v=4" alt="RoamHaven Logo" class="brand-logo">
        <span class="brand-text">RoamHaven</span>
      </div>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <!-- Left side - empty for now -->
      <div class="navbar-nav">
      </div>

      <!-- Feature #12: Centered Search Pill — wired to server-side search -->
      <div class="navbar-search-container">
        <form action="/listings" method="GET" class="search-form-nav" id="navSearchForm">
          <div class="search-bar-pill shadow-sm">
            <div class="search-inputs">
              <div class="search-item flex-grow-1">
                <span class="search-label">Where</span>
                <input class="search-input" type="text" name="q" placeholder="Search PGs, hostels, hotels, cities..."
                       id="navSearchInput" autocomplete="off">
              </div>
            </div>
            <button type="submit" class="search-icon-btn">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </div>
        </form>
      </div>

      <!-- Right side buttons -->
      <div class="navbar-nav ms-auto gap-2 align-items-center">
        <a class="nav-link nav-btn" href="/listings/new"><i class="fa-solid fa-plus me-1"></i>List Stay / PG</a>
        <% if(!safeCurrUser) { %>
          <a class="nav-link nav-btn" href="/signup">Sign Up</a>
          <a class="nav-link nav-btn" href="/login">Log in</a>
        <% } %>
        <% if(safeCurrUser) { %>
          <a class="nav-link nav-btn" href="/trips">🧭 Trips</a>
          <div class="dropdown">
            <a
              class="nav-link nav-btn position-relative dropdown-toggle"
              href="#"
              id="notifDropdownToggle"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              🔔 Notifications
              <span
                id="notifBadge"
                class="badge rounded-pill text-bg-danger position-absolute top-0 start-100 translate-middle"
                style="<%= unreadNotificationCount && unreadNotificationCount > 0 ? '' : 'display:none;' %>"
              ><%= unreadNotificationCount && unreadNotificationCount > 99 ? '99+' : (unreadNotificationCount || 0) %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" style="min-width: 360px;">
              <li class="px-3 py-2 d-flex align-items-center justify-content-between">
                <span class="fw-semibold">Notifications</span>
                <a href="#" class="small text-decoration-none" id="notifMarkAllReadBtn">Mark all read</a>
              </li>
              <li><hr class="dropdown-divider my-1"></li>
              <li id="notifDropdownList">
                <div class="dropdown-item text-muted small">Loading…</div>
              </li>
            </ul>
          </div>
          <a class="nav-link nav-btn position-relative" href="/wallet" title="Wallet balance">
            💰 Wallet
            <span class="wallet-badge ms-1">
              ₹<%= Math.floor((safeWalletBalance || 0) / 100).toLocaleString("en-IN") %>
            </span>
          </a>
          <a class="nav-link nav-btn" href="/bookings/my">📅 Bookings</a>
          <a class="nav-link nav-btn" href="/bookings/history">📋 Payments</a>
          <span class="nav-link nav-btn" title="Loyalty points">🏅 <%= safeLoyaltyPoints || 0 %> pts</span>
          <% if (safeUserRole === 'host') { %>
            <a class="nav-link nav-btn" href="/revenue">📊 Revenue</a>
          <% } %>
          <% if (safeUserRole === 'admin') { %>
            <a class="nav-link nav-btn" href="/admin">📊 Admin</a>
            <a class="nav-link nav-btn" href="/admin/coupons">🎫 Coupons</a>
          <% } %>
          <!-- Account Dropdown -->
          <div class="dropdown">
            <button class="btn nav-account-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <div class="nav-avatar-circle">
                <%= safeCurrUser.username.charAt(0).toUpperCase() %>
              </div>
              <span class="nav-username d-none d-md-inline"><%= safeCurrUser.username %></span>
              <% if (safeUserRole === 'admin') { %>
                <span class="role-badge role-admin">Admin</span>
              <% } else if (safeUserRole === 'host') { %>
                <span class="role-badge role-host">Host</span>
              <% } %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 account-dropdown">
              <li class="dropdown-header">
                <div class="d-flex align-items-center gap-2">
                  <div class="dropdown-avatar-circle">
                    <%= safeCurrUser.username.charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <div class="fw-bold"><%= safeCurrUser.username %></div>
                    <div class="text-muted small"><%= safeCurrUser.email %></div>
                  </div>
                </div>
                <% if (!safeIsEmailVerified) { %>
                  <a href="/verify-email" class="verify-prompt mt-2 d-block">
                    <i class="fa-solid fa-triangle-exclamation"></i> Verify your email
                  </a>
                <% } %>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item" href="/profile">
                  <i class="fa-solid fa-user me-2"></i> Profile
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/wishlist">
                  <i class="fa-solid fa-heart me-2"></i> Wishlist
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/account/sessions">
                  <i class="fa-solid fa-shield-halved me-2"></i> Sessions
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/account/activity">
                  <i class="fa-solid fa-clock-rotate-left me-2"></i> Login Activity
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/account/verify-id">
                  <i class="fa-solid fa-id-card me-2"></i> Verify ID
                  <span class="badge text-bg-light ms-2"><%= safeIdVerificationStatus %></span>
                </a>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item text-danger" href="/logout">
                  <i class="fa-solid fa-right-from-bracket me-2"></i> Log Out
                </a>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>
