<% layout("/layouts/boilerplate") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="text-center mb-4">
        <h2 class="fw-bold">Booking confirmed</h2>
        <p class="text-muted mb-0">
          Payment was verified successfully.
        </p>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
            <div>
              <div class="fw-semibold">Listing</div>
              <div class="mb-2">
                <%= booking.listing ? booking.listing.title : "" %>
              </div>
              <div class="text-muted small">
                Booking ID: <%= booking._id %>
              </div>
            </div>
            <div class="text-end">
              <div class="fw-semibold">Paid</div>
              <div class="h4 mb-0">
                ₹<%= Math.round((booking.payment?.amount || 0) / 100).toLocaleString("en-IN") %>
              </div>
            </div>
          </div>

          <hr />

          <div class="row g-3">
            <div class="col-md-4">
              <div class="text-muted small">Wallet used</div>
              <div class="fw-semibold">
                ₹<%= Math.round((booking.payment?.walletUsed || 0) / 100).toLocaleString("en-IN") %>
              </div>
            </div>
            <div class="col-md-4">
              <div class="text-muted small">Host payout (after commission)</div>
              <div class="fw-semibold">
                ₹<%= Math.round((booking.payment?.hostPayout || 0) / 100).toLocaleString("en-IN") %>
              </div>
            </div>
            <div class="col-md-4">
              <div class="text-muted small">Coupon discount</div>
              <div class="fw-semibold">
                ₹<%= Math.round((booking.payment?.discount || 0) / 100).toLocaleString("en-IN") %>
              </div>
            </div>
          </div>

          <div class="mt-4 d-flex flex-wrap gap-2 justify-content-center">
            <a href="/bookings/history" class="btn btn-outline-dark">View payment history</a>
            <a href="/wallet" class="btn btn-outline-secondary">Go to wallet</a>

            <% if (booking.payment && booking.payment.status === "paid") { %>
              <form action="/bookings/<%= booking._id %>/refund" method="POST">
                <button type="submit" class="btn btn-outline-danger">
                  Request refund
                </button>
              </form>
            <% } %>
          </div>
        </div>
      </div>

      <div class="text-center mt-3">
        <a href="/listings" class="text-decoration-none">Back to listings</a>
      </div>
    </div>
  </div>
</div>

