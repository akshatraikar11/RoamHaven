<% layout("/layouts/boilerplate") %>

<div class="booking-request-page">
  <div class="booking-header">
    <div class="container-fluid px-5 py-3">
      <a href="/listings/<%= listing._id %>" class="back-link">
        <i class="fa-solid fa-arrow-left"></i>
      </a>
      <h1 class="booking-title">Book your stay</h1>
    </div>
  </div>

  <div class="container-fluid px-5 py-4">
    <div class="row">
      <!-- Left Column - Form -->
      <div class="col-lg-7">
        <form id="bookingForm">
          <input type="hidden" id="listingId" value="<%= listing._id %>">

          <div class="booking-section">
            <h2 class="section-heading">Message the host</h2>
            <p class="section-subtext">
              Before you can continue, let
              <%= listing.owner && listing.owner.username ? listing.owner.username : "the host" %>
              know a little about your trip and why their place is a good fit.
            </p>

            <div class="host-info-mini">
              <div class="host-avatar-small">
                <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : "H" %>
              </div>
              <div>
                <h4 class="host-name">
                  <%= listing.owner && listing.owner.username ? listing.owner.username : "Host" %>
                </h4>
                <p class="host-tenure">Hosting since 2025</p>
              </div>
            </div>

            <textarea
              class="form-control message-textarea"
              name="message"
              id="guestMessage"
              rows="5"
              placeholder="Example: Hi there, my partner and I are going to a friend's wedding and your place is just down the road."
            ></textarea>
          </div>

          <hr class="section-divider" />

          <div class="booking-section">
            <h2 class="section-heading">Your information</h2>
            <div class="mb-3">
              <label class="form-label">Full Name</label>
              <input type="text" name="name" id="guestName" class="form-control booking-input" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Mobile Number</label>
              <input type="tel" name="mobile" id="guestMobile" class="form-control booking-input" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Email</label>
              <input type="email" name="email" id="guestEmail" class="form-control booking-input" required />
            </div>
          </div>

          <hr class="section-divider" />

          <div class="booking-section">
            <h2 class="section-heading">Dates</h2>
            <div class="detail-row">
              <div class="detail-value-group">
                <input
                  type="date"
                  id="startDate"
                  class="form-control date-input"
                  required
                  value="<%= defaults && defaults.startDate ? defaults.startDate : '' %>"
                />
                <span class="date-separator">to</span>
                <input
                  type="date"
                  id="endDate"
                  class="form-control date-input"
                  required
                  value="<%= defaults && defaults.endDate ? defaults.endDate : '' %>"
                />
              </div>
            </div>
          </div>

          <hr class="section-divider" />

          <div class="booking-section">
            <h2 class="section-heading">Coupon & wallet</h2>

            <div class="mb-3 coupon-row">
              <label class="form-label">Coupon code</label>
              <div class="coupon-input-group">
                <input
                  type="text"
                  id="couponCode"
                  class="form-control booking-input"
                  placeholder="e.g. WELCOME20"
                />
                <button type="button" id="applyCouponBtn" class="btn btn-outline-dark">Apply</button>
              </div>
              <div id="couponMessage" class="mt-2 text-muted small"></div>
            </div>

            <div class="wallet-toggle">
              <div class="d-flex align-items-center justify-content-between">
                <label class="form-label m-0">Use wallet</label>
                <div class="text-muted small">
                  Available: ₹<span id="walletBalanceRupees"><%= Math.floor(walletBalancePaise/100).toLocaleString("en-IN") %></span>
                </div>
              </div>
              <div class="mt-2">
                <input type="checkbox" id="useWalletCheckbox" checked />
                <label for="useWalletCheckbox" class="ms-2">Pay using wallet balance first</label>
              </div>
            </div>
          </div>

          <hr class="section-divider" />

          <div class="booking-section">
            <h2 class="section-heading">Select Payment Method</h2>
            
            <div class="payment-method-selector mb-3">
              <div class="form-check p-3 border rounded-3 mb-2 d-flex align-items-center">
                <input class="form-check-input me-3" type="radio" name="paymentGateway" id="paymentMethodRazorpay" value="razorpay" checked>
                <label class="form-check-label w-100 cursor-pointer" for="paymentMethodRazorpay">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <strong>Cards & Netbanking (Razorpay)</strong>
                      <div class="text-muted small">Cards, Netbanking & Wallets</div>
                    </div>
                    <span class="badge bg-light text-dark border">Standard</span>
                  </div>
                </label>
              </div>

              <div class="form-check p-3 border rounded-3 mb-2 d-flex align-items-center">
                <input class="form-check-input me-3" type="radio" name="paymentGateway" id="paymentMethodUpi" value="upi">
                <label class="form-check-label w-100 cursor-pointer" for="paymentMethodUpi">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <strong><i class="fa-solid fa-qrcode text-success me-1"></i> Direct UPI QR (Zero Fee)</strong>
                      <div class="text-muted small">GPay, PhonePe, Paytm, BHIM, Cred</div>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">0% Fee</span>
                  </div>
                </label>
              </div>
            </div>

            <p class="payment-info">
              <i class="fa-solid fa-circle-info text-primary"></i>
              Your booking will be confirmed once the payment is verified. If you refund, amount is credited to wallet.
            </p>
            <p class="payment-info">
              <i class="fa-solid fa-circle-info text-primary"></i>
              Your booking will be confirmed once the payment is verified. If you refund, amount is credited to wallet.
            </p>
          </div>

          <hr class="section-divider" />

          <div class="booking-section">
            <p class="terms-text">
              By selecting the button, I agree to the <a href="#" class="terms-link">booking terms</a>.
            </p>

            <button type="submit" id="payBtn" class="btn btn-dark btn-lg w-100 continue-btn">
              Pay with Razorpay
            </button>

            <div id="paymentError" class="mt-3 text-danger" style="display:none;"></div>
          </div>
        </form>
      </div>

      <!-- Right Column - Booking Summary Card -->
      <div class="col-lg-5">
        <div class="booking-summary-sticky">
          <div class="booking-summary-card">
            <div class="listing-preview">
              <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="listing-thumbnail">
              <div class="listing-info-mini">
                <h3 class="listing-name"><%= listing.title %></h3>
                <p class="listing-rating">
                  <i class="fa-solid fa-star"></i> 4.83 (40)
                </p>
              </div>
            </div>

            <hr class="my-3" />

            <div class="policy-section">
              <h4 class="policy-title">Free cancellation</h4>
              <p class="policy-text">
                Cancel within 24 hours for a full refund. <a href="#" class="policy-link">Full policy</a>
              </p>
            </div>

            <hr class="my-3" />

            <div class="price-details">
              <h4 class="price-title">Price breakdown</h4>

              <div class="price-row">
                <span class="price-label">Subtotal</span>
                <span class="price-value" id="subtotalDisplay">₹<%= Math.floor(price.subtotalPaise/100).toLocaleString("en-IN") %></span>
              </div>
              <div class="price-row">
                <span class="price-label">Service fee (5%)</span>
                <span class="price-value" id="serviceFeeDisplay">₹<%= Math.floor(price.serviceFeePaise/100).toLocaleString("en-IN") %></span>
              </div>
              <hr class="my-2" />
              <div class="price-row">
                <span class="price-label"><strong>Total before discount</strong></span>
                <span class="price-value" id="totalBeforeDiscountDisplay">
                  ₹<%= Math.floor(price.totalPaise/100).toLocaleString("en-IN") %>
                </span>
              </div>

              <div class="price-row coupon-discount-row">
                <span class="price-label">Coupon discount</span>
                <span class="price-value" id="couponDiscountDisplay">- ₹0</span>
              </div>

              <div class="price-row wallet-discount-row">
                <span class="price-label">Wallet used</span>
                <span class="price-value" id="walletUsedDisplay">- ₹0</span>
              </div>

              <hr class="my-2" />

              <div class="price-row price-total">
                <span><strong>Payable via Razorpay</strong></span>
                <span class="price-value"><strong id="razorpayAmountDisplay">₹<%= Math.floor(price.totalPaise/100).toLocaleString("en-IN") %></strong></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  
<!-- UPI QR Payment Modal -->
<div class="modal fade" id="upiPaymentModal" tabindex="-1" aria-labelledby="upiModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold" id="upiModalLabel">
          <i class="fa-solid fa-qrcode text-success me-2"></i> Scan & Pay via UPI
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center px-4 py-3">
        <p class="text-muted small mb-3">Scan this QR code using any UPI app or click the button below on mobile.</p>
        
        <div class="p-3 bg-light rounded-3 d-inline-block border mb-3">
          <img id="upiQrCodeImg" src="" alt="UPI QR Code" style="width: 220px; height: 220px; object-fit: contain;" />
        </div>

        <div class="mb-3">
          <span class="badge bg-dark px-3 py-2 fs-6">Payable: ₹<span id="upiModalAmount">0</span></span>
        </div>

        <div class="d-grid mb-3 d-md-none">
          <a id="upiAppDeepLink" href="#" class="btn btn-success fw-semibold">
            <i class="fa-solid fa-mobile-screen-button me-2"></i> Open in UPI App
          </a>
        </div>

        <hr class="my-3" />

        <div class="text-start">
          <label class="form-label small fw-semibold">Enter 12-Digit Bank UTR / Ref No.</label>
          <div class="input-group mb-2">
            <input type="text" id="upiUtrInput" class="form-control" placeholder="e.g. 412345678901" maxlength="12" />
            <button class="btn btn-dark" type="button" id="verifyUtrBtn">Verify & Confirm</button>
          </div>
          <div id="utrMessage" class="small"></div>
        </div>
      </div>
    </div>
  </div>
</div>

</div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const listingId = document.getElementById("listingId").value;
  const startDateInput = document.getElementById("startDate");
  const endDateInput = document.getElementById("endDate");
  const walletBalancePaise = <%= walletBalancePaise || 0 %>;

  const couponCodeInput = document.getElementById("couponCode");
  const applyCouponBtn = document.getElementById("applyCouponBtn");
  const couponMessage = document.getElementById("couponMessage");

  const useWalletCheckbox = document.getElementById("useWalletCheckbox");

  const payBtn = document.getElementById("payBtn");
  const paymentError = document.getElementById("paymentError");

  const subtotalDisplay = document.getElementById("subtotalDisplay");
  const serviceFeeDisplay = document.getElementById("serviceFeeDisplay");
  const totalBeforeDiscountDisplay = document.getElementById("totalBeforeDiscountDisplay");
  const couponDiscountDisplay = document.getElementById("couponDiscountDisplay");
  const walletUsedDisplay = document.getElementById("walletUsedDisplay");
  const razorpayAmountDisplay = document.getElementById("razorpayAmountDisplay");

  let couponDiscountPaise = 0;
  let totalPaiseAfterDiscount = <%= price.totalPaise || 0 %>;
  let razorpayAmountPaise = totalPaiseAfterDiscount;

  function formatRupeesFromPaise(paise) {
    const rupees = Math.floor(paise / 100);
    return rupees.toLocaleString("en-IN");
  }

  async function fetchTotals() {
    const checkIn = encodeURIComponent(startDateInput.value);
    const checkOut = encodeURIComponent(endDateInput.value);

    const res = await fetch(`/listings/${listingId}/dynamic-price?checkIn=${checkIn}&checkOut=${checkOut}`);
    const data = await res.json();
    if (!data || data.totalPrice == null) throw new Error("Failed to calculate price.");

    const subtotalRupees = Math.round(data.totalPrice);
    const serviceFeeRupees = Math.round(subtotalRupees * 0.05);
    const totalRupees = subtotalRupees + serviceFeeRupees;

    // Keep in paise for server compatibility
    subtotalDisplay.textContent = `₹${subtotalRupees.toLocaleString("en-IN")}`;
    serviceFeeDisplay.textContent = `₹${serviceFeeRupees.toLocaleString("en-IN")}`;
    totalBeforeDiscountDisplay.textContent = `₹${totalRupees.toLocaleString("en-IN")}`;

    // Reset coupon when dates change; coupon must be re-applied for correct discount.
    couponDiscountPaise = 0;
    totalPaiseAfterDiscount = totalRupees * 100;
    couponDiscountDisplay.textContent = `- ₹0`;
    couponMessage.textContent = "";

    recalcWalletAndRazorpay();
  }

  function recalcWalletAndRazorpay() {
    const wantsWallet = useWalletCheckbox.checked;
    const walletUsedPaise = wantsWallet ? Math.min(walletBalancePaise, totalPaiseAfterDiscount) : 0;
    razorpayAmountPaise = Math.max(0, totalPaiseAfterDiscount - walletUsedPaise);

    walletUsedDisplay.textContent = `- ₹${formatRupeesFromPaise(walletUsedPaise)}`;
    razorpayAmountDisplay.textContent = `₹${formatRupeesFromPaise(razorpayAmountPaise)}`;
  }

  startDateInput.addEventListener("change", async () => {
    if (endDateInput.value && endDateInput.value < startDateInput.value) {
      endDateInput.value = startDateInput.value;
    }
    try {
      await fetchTotals();
    } catch (e) {
      console.error(e);
    }
  });
  endDateInput.addEventListener("change", fetchTotals);
  useWalletCheckbox.addEventListener("change", recalcWalletAndRazorpay);

  applyCouponBtn.addEventListener("click", async () => {
    const couponCode = couponCodeInput.value.trim();
    couponMessage.textContent = "Applying coupon...";
    try {
      const res = await fetch("/bookings/apply-coupon", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          listingId,
          startDate: startDateInput.value,
          endDate: endDateInput.value,
          couponCode,
        }),
      });
      const data = await res.json();
      if (!data.success) {
        couponMessage.textContent = data.error || "Coupon not applied.";
        couponDiscountPaise = 0;
        await fetchTotals();
        couponMessage.textContent = data.error || "Coupon not applied.";
        return;
      }

      couponDiscountPaise = data.discountPaise || 0;
      totalPaiseAfterDiscount = data.totalAfterDiscountPaise || totalPaiseAfterDiscount;
      couponDiscountDisplay.textContent = `- ₹${formatRupeesFromPaise(couponDiscountPaise)}`;
      couponMessage.textContent = "Coupon applied successfully.";
      recalcWalletAndRazorpay();
    } catch (e) {
      couponMessage.textContent = "Failed to apply coupon.";
      console.error(e);
    }
  });

  
  // UPI QR Flow Handling
  let currentUpiBookingId = null;

  document.querySelectorAll('input[name="paymentGateway"]').forEach(radio => {
    radio.addEventListener('change', (e) => {
      if (e.target.value === 'upi') {
        payBtn.textContent = 'Generate UPI QR Code';
      } else {
        payBtn.textContent = 'Pay with Razorpay';
      }
    });
  });

  const verifyUtrBtn = document.getElementById("verifyUtrBtn");
  const upiUtrInput = document.getElementById("upiUtrInput");
  const utrMessage = document.getElementById("utrMessage");

  if (verifyUtrBtn) {
    verifyUtrBtn.addEventListener("click", async () => {
      const utr = (upiUtrInput.value || "").trim();
      if (!/^\d{12}$/.test(utr)) {
        utrMessage.textContent = "Please enter a valid 12-digit numeric UTR number.";
        utrMessage.className = "small text-danger";
        return;
      }

      utrMessage.textContent = "Verifying transaction with ledger...";
      utrMessage.className = "small text-info";
      verifyUtrBtn.disabled = true;

      try {
        const res = await fetch("/bookings/upi/verify-payment", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            bookingId: currentUpiBookingId,
            utrNumber: utr,
          }),
        });
        const data = await res.json();
        if (data.success && data.redirectUrl) {
          window.location.href = data.redirectUrl;
        } else {
          utrMessage.textContent = data.error || "Verification failed. Check UTR.";
          utrMessage.className = "small text-danger";
          verifyUtrBtn.disabled = false;
        }
      } catch (err) {
        utrMessage.textContent = "Network error during verification.";
        utrMessage.className = "small text-danger";
        verifyUtrBtn.disabled = false;
      }
    });
  }

  document.getElementById("bookingForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    paymentError.style.display = "none";
    payBtn.disabled = true;
    try {
      const payload = {
        listingId,
        startDate: startDateInput.value,
        endDate: endDateInput.value,
        name: document.getElementById("guestName").value,
        mobile: document.getElementById("guestMobile").value,
        email: document.getElementById("guestEmail").value,
        message: document.getElementById("guestMessage")?.value || "",
        couponCode: couponCodeInput.value.trim(),
        useWallet: useWalletCheckbox.checked,
      };

      const selectedGateway = document.querySelector('input[name="paymentGateway"]:checked')?.value || 'razorpay';
      const orderEndpoint = selectedGateway === 'upi' ? '/bookings/upi/create-order' : '/bookings/create-order';

      const res = await fetch(orderEndpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!data.success) {
        throw new Error(data.error || "Payment order creation failed.");
      }

      if (data.redirectUrl) {
        window.location.href = data.redirectUrl;
        return;
      }

      // If direct UPI response:
      if (selectedGateway === 'upi' && data.upiUri) {
        currentUpiBookingId = data.bookingId;
        document.getElementById("upiQrCodeImg").src = data.qrImageUrl;
        document.getElementById("upiModalAmount").textContent = data.amountRupees;
        document.getElementById("upiAppDeepLink").href = data.upiUri;
        const modal = new bootstrap.Modal(document.getElementById("upiPaymentModal"));
        modal.show();
        payBtn.disabled = false;
        return;
      }

      const options = {
        key: data.keyId,
        amount: data.amountPaise,
        currency: "INR",
        name: "RoamHaven",
        description: "Booking payment",
        order_id: data.orderId,
        prefill: {
          name: payload.name,
          email: payload.email,
          contact: payload.mobile,
        },
        handler: function (response) {
          // Verify on server
          fetch("/bookings/verify-payment", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              bookingId: data.bookingId,
              razorpay_order_id: data.orderId,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature: response.razorpay_signature,
            }),
          })
            .then((r) => r.json())
            .then((verifyRes) => {
              if (verifyRes.success) {
                window.location.href = verifyRes.redirectUrl;
              } else {
                throw new Error(verifyRes.error || "Payment verification failed.");
              }
            })
            .catch((err) => {
              console.error(err);
              paymentError.textContent = err.message || "Payment verification failed.";
              paymentError.style.display = "block";
              payBtn.disabled = false;
            });
        },
      };

      const rzp = new Razorpay(options);
      rzp.open();
    } catch (err) {
      paymentError.textContent = err.message || "Something went wrong.";
      paymentError.style.display = "block";
      payBtn.disabled = false;
    }
  });

  // Initial totals load
  (async function init() {
    try {
      await fetchTotals();
    } catch (e) {
      console.error(e);
    }
  })();
</script>